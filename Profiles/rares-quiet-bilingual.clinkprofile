{
  "id": "rares.quiet-bilingual",
  "name": "Rares Quiet Bilingual",
  "icon": "keyboard",
  "config": {
    "soundEnabled": false,
    "showNumberRow": true,
    "numberRowHeightScale": 0.8,
    "numberRowFontSize": 17,
    "hapticsEnabled": true,
    "hapticIntensity": 0.3,
    "hapticSharpness": 0.5,
    "cursorActivationHaptic": true,
    "keyPopupEnabled": true,
    "keyPopupStyle": "floating",
    "cursorMovementType": "spacebar",
    "spaceCursorActivationDelay": 200,
    "punctuationSpacingEnabled": true,
    "autoPunctuationEnabled": false,
    "keyPressInstant": true,
    "keyBloomScale": 1,
    "keySpringResponse": 0.1,
    "keySpringDamping": 1,
    "keyPressLinger": 0,
    "minPressVisible": 0,
    "spaceBloomScale": 1,
    "spaceSpringResponse": 0.1,
    "spaceSpringDamping": 1,
    "spaceLeanMultiplier": 0,
    "spaceCursorDragScale": 1,
    "popupSpringResponse": 0.16,
    "popupSpringDamping": 1,
    "glassReleaseResponse": 0.06,
    "swipeShowTrail": false,
    "swipeKeyMorph": false,
    "suggestionDebounceDelay": 80
  }
}
