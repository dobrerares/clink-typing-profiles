{
  "id": "rares.glass",
  "name": "Rares Glass",
  "icon": "sparkles",
  "config": {
    "soundEnabled": false,
    "showNumberRow": true,
    "numberRowHeightScale": 0.8,
    "numberRowFontSize": 17,
    "hapticsEnabled": true,
    "hapticIntensity": 0.3,
    "hapticSharpness": 0.5,
    "cursorActivationHaptic": true,
    "keyPopupEnabled": true,
    "keyPopupStyle": "floating",
    "cursorMovementType": "spacebar",
    "spaceCursorActivationDelay": 200,
    "punctuationSpacingEnabled": true,
    "autoPunctuationEnabled": true,
    "keyPressInstant": false,
    "keyBloomScale": 1,
    "keySpringResponse": 0.16,
    "keySpringDamping": 0.88,
    "keyPressLinger": 0,
    "minPressVisible": 0,
    "spaceBloomScale": 1,
    "spaceSpringResponse": 0.16,
    "spaceSpringDamping": 0.9,
    "spaceLeanMultiplier": 0,
    "spaceCursorDragScale": 1,
    "popupSpringResponse": 0.22,
    "popupSpringDamping": 0.82,
    "glassReleaseResponse": 0.12,
    "swipeShowTrail": false,
    "swipeKeyMorph": false,
    "suggestionDebounceDelay": 80
  }
}
